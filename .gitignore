# ---- Knowledge base (676 MB, exceeds GitHub's 100 MB per-file limit) ----
# Transferred separately by scp/USB. See README.md "Getting the knowledge base".
data/chroma_db/
*.sqlite3
*.zip

# ---- Machine-specific config ----
# RENDER_GID/VIDEO_GID differ per machine; deploy.sh regenerates this every run.
.env

# ---- Runtime-generated evaluation data ----
# Accumulates as users rate answers; back this up separately, do not version it.
data_eval/*.csv

# ---- Working backups (not meaningful to a fresh clone) ----
*.bak-torchfix
*.bak-predeploy

# ---- Python / OS noise ----
__pycache__/
*.py[cod]
.DS_Store
__MACOSX/
