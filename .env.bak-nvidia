CHROMA_PERSIST_DIR=/app/data/chroma_db
CHROMA_COLLECTION_NAME=dbp_khidmatnasihat_clean_atomic

# The chatbot container uses Linux host networking so it can call llmster on host localhost.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1/
LMSTUDIO_MODEL=google/gemma-3-4b
LMSTUDIO_TIMEOUT_S=60

# Preserve initial thesis retrieval configuration. Optimise to GPU only after validation.
RAG_DEVICE=cpu
RAG_USE_FP16=false
