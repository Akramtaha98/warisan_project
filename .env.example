# TEMPLATE ONLY - do not copy this to .env by hand.
#
# Run ./deploy.sh instead. It generates .env with the correct values for the
# machine it is run on. RENDER_GID and VIDEO_GID in particular are different on
# every machine, and wrong values are the most common cause of "the GPU is not
# detected" on a new server.

CHROMA_PERSIST_DIR=/app/data/chroma_db
CHROMA_COLLECTION_NAME=dbp_khidmatnasihat_clean_atomic

# Points at the llama.cpp Vulkan container over the private Docker network.
# The LMSTUDIO_* names are kept only for compatibility with the existing app
# code - there is no LM Studio in this architecture.
LMSTUDIO_BASE_URL=http://llm:8080/v1/
LMSTUDIO_MODEL=Qwen/Qwen3-8B
LMSTUDIO_TIMEOUT_S=120

# Retrieval/reranking stay on CPU. Only the LLM uses the GPU.
RAG_DEVICE=cpu
RAG_USE_FP16=false

# Retrieval policy. Medium-confidence results expand from 15 to 40 candidates;
# at most six reranked chunks are given to the answer model.
RAG_K_SMALL=15
RAG_K_LARGE=40
RAG_FINAL_N=6
RAG_MIN_KEEP_SCORE=0.8
RAG_EXPAND_SCORE=1.5
RAG_HYDE_SCORE=1.0
RAG_ANSWER_SCORE=0.8

# GGUF model pulled by llama.cpp on first start.
LLAMA_HF_REPO=Qwen/Qwen3-8B-GGUF:Q5_K_M

# React/FastAPI port published to the host.
CHATBOT_HOST_PORT=18501

# AMD GPU passthrough. MACHINE-SPECIFIC - detect with:
#   getent group render | cut -d: -f3
#   getent group video  | cut -d: -f3
RENDER_GID=
VIDEO_GID=
